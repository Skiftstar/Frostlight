(
  defwindow applauncher
  :class "app-launcher"
  :monitor 0
  :geometry (geometry :x "0%"
                      :y "0%"
                      :width "20%"
                      :height "40%"
                      :anchor "center")
  :stacking "fg"
  :focusable true
  :windowtype "normal"
  :wm-ignore false
  
  (
    scroll
    :class "app-launcher"
    (
      box
      :orientation "v"
      :space-evenly false
      (
        input
        :class "app-searchbox"
        :onchange "scripts/apps.py '{}'" 
      )
      (
        for app in apps
        (
          button
          :class "app-btn"
          :onclick "scripts/control/togglelauncher.sh && nohup ${app.exec} >/dev/null 2>&1 &"
            (box 
              :orientation "h"
              :spacing 10
              :space-evenly false
              (
                image 
                  :path "${app.icon}"
                  :image-width 32
                  :image-height 32
                  :preserve-aspect-ratio false
              )
              (
                label 
                  :text "${app.name}"
                  :xalign 0
              )
            )
        )
      )
    )
  )
)
